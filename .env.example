# Chat widget (Dinnerplans AI embed)
# Local defaults are used if unset.

# Full URL to embed.js
CHAT_EMBED_SRC=http://localhost:3017/embed.js

# Restaurant machineName (data-restaurant)
CHAT_RESTAURANT=natur

# data-auto-open is hardcoded in index.html (welcome teaser)

# Production example:
# CHAT_EMBED_SRC=https://chat.dinnerplans.se/embed.js
# CHAT_RESTAURANT=demokrogen

# Staging example:
# CHAT_EMBED_SRC=https://chat.orrmyrdev.se/embed.js
# CHAT_RESTAURANT=demokrogen
